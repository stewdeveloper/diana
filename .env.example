# =============================================
# Diana - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/diana

# --- League of Legends Bot (Diana) ---
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=your-discord-client-id-here

# --- Apex Legends Bot (Pathfinder) ---
APEX_DISCORD_BOT_TOKEN=your-apex-discord-bot-token-here
APEX_DISCORD_CLIENT_ID=your-apex-discord-client-id-here

# --- Rainbow Six Siege Bot (Ash) ---
# Unset, the Ash bot simply does not start; the other two are unaffected.
R6_DISCORD_BOT_TOKEN=your-r6-discord-bot-token-here
R6_DISCORD_CLIENT_ID=your-r6-discord-client-id-here

# --- API Keys ---
RIOT_API_KEY=RGAPI-your-riot-api-key-here
APEX_API_KEY=your-mozambiquehe-re-api-key-here
# r6data key (r6data.com dashboard). Unset, the R6 plugin falls back to its
# mock service rather than failing to load.
R6DATA_API_KEY=your-r6data-api-key-here
# Ladder version passed to /api/ranks. Bump when Ubisoft reworks ranked.
R6DATA_RANKS_VERSION=v7

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-secure-random-string-here

# --- Server ---
PORT=3000
# NODE_ENV must be set to "production" in deployed environments so that auth
# cookies are sent with the Secure flag (HTTPS only). Omitting this in prod
# will allow session cookies over plain HTTP.
NODE_ENV=production
# DISCORD_GUILD_ID=         # Restrict slash commands to one server (faster for dev)
# DISCORD_CHANNEL_ID=       # Default notification channel
# DIANA_CONFIG_DIR=./data   # Directory for plugins.json state file

# --- Feature flags ---
# USE_MOCK_RIOT_API=true     # Use mock Riot data (default: false, uses real API)
# MOCK_APEX_SERVICE=false    # Force mock Apex data
# FORCE_DEVELOPMENT_TIMERS=false  # Use shorter poll intervals for dev
# STOP_BOT=false             # Disable all background jobs
# DISABLE_DISCORD_POSTS=false     # Don't send Discord messages (dry run)

# --- Support link (shown on match end embeds) ---
# SUPPORT_URL=https://buymeacoffee.com/yngstew

# --- Meeps webhook (optional external notifications) ---
# MEEPS_WEBHOOK_URL=
# MEEPS_WEBHOOK_SECRET=
# Inbound presence from the Meeps client (DN-5). Leave unset to keep
# /api/presence disabled - it answers 503 rather than accepting unauthenticated
# personal data.
# MEEPS_INBOUND_SECRET=
